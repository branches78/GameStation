<?xml version="1.0" encoding="utf-8"?>
<!-- Like the mobile outlined button; filled with the TV accent green when focused with the remote. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_tab_corner_radius" />
            <solid android:color="@color/tv_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_tab_corner_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/md_theme_dark_outline" />
        </shape>
    </item>
</selector>
