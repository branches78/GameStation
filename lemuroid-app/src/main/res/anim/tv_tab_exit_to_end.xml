<?xml version="1.0" encoding="utf-8"?>
<!-- Tab content sliding sideways when another tab is selected (TVMainTabsFragment). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/tv_tab_animation_duration"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <translate
        android:fromXDelta="0"
        android:toXDelta="10%" />
    <alpha
        android:fromAlpha="1"
        android:toAlpha="0" />
</set>
