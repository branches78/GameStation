<?xml version="1.0" encoding="utf-8"?>
<!-- Texts of the immersive list of the TV home screen: the game focused in its row. They always take the same height
     (one line of title, three of description), as the row below them is placed right after them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/tv_immersive_info_width"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tv_immersive_info_top_margin"
    android:alpha="0"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_immersive_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/md_theme_dark_onSurface"
        android:textSize="@dimen/tv_immersive_title_size" />

    <TextView
        android:id="@+id/tv_immersive_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/md_theme_dark_primary"
        android:textSize="@dimen/tv_immersive_meta_size" />

    <TextView
        android:id="@+id/tv_immersive_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.2"
        android:lines="3"
        android:textColor="@color/md_theme_dark_onSurfaceVariant"
        android:textSize="@dimen/tv_immersive_description_size" />

</LinearLayout>
